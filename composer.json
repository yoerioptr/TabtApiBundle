{
  "name": "yoerioptr/tabt-api-bundle",
  "description": "Symfony inteagration for the TabT API client",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "yoerioptr/tabt-api-client": "^2.1",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "Yoerioptr\\TabtApiBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "Yoerioptr\\TabtApiBundle\\Tests": "test/"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}
